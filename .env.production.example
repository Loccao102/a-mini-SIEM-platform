# Copy to .env.production; fill every secret with a different random value.
# node scripts/production-preflight.mjs --env .env.production
MODE=production
POSTGRES_DB=siem
POSTGRES_USER=siem
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
# Public hostname points to VPS IP. Caddy will request a Let's Encrypt certificate.
SIEM_DOMAIN=
ACME_EMAIL=
# Exactly https://SIEM_DOMAIN without /api or a trailing slash.
NEXT_PUBLIC_API_URL=
# All ports remain bound to loopback. Publish only an HTTPS reverse proxy.
POSTGRES_BIND_HOST=127.0.0.1
REDIS_BIND_HOST=127.0.0.1
ELASTICSEARCH_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
BEATS_BIND_HOST=127.0.0.1
FLEET_BIND_HOST=127.0.0.1
# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Enable TLS proxy explicitly with: docker compose --profile production --env-file .env.production up -d --build
